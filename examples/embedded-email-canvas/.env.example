# Host app: the exact origin, including port. Never infer this from a request.
APP_ORIGIN=http://localhost:3500
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs. Sign-in alone does not grant Brew access.
DEMO_ALLOWED_USER_IDS=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CANVAS_SESSION_SECRET=
# Server-only Brew key with the emails scope and access to this brand.
BREW_API_KEY=
BREW_BRAND_ID=
BREW_GROUP_ID=
# Optional: enable a separate single-email view.
BREW_EMAIL_ID=
# Set false for a read-only review portal. The browser cannot upgrade this.
CANVAS_CAN_EDIT=true
# Use a trusted preview origin until the embed feature ships to brew.new.
BREW_EMBED_ORIGIN=https://brew.new
