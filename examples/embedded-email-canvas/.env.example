# Create in Brew Settings → API → Client apps. Allow http://localhost:3500.
# This is a publishable client ID. No API key or Clerk keys are needed.
NEXT_PUBLIC_BREW_CLIENT_ID=
# Set at least one target. Set both to show the group/single-email chooser.
BREW_GROUP_ID=
BREW_EMAIL_ID=
# Optional: use a trusted preview origin until this feature ships to brew.new.
BREW_EMBED_ORIGIN=https://brew.new
