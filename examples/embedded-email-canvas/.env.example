# Create in Brew Settings → API → Client apps. Allow http://localhost:3500.
# This is a publishable client ID. No API key or Clerk keys are needed.
NEXT_PUBLIC_BREW_CLIENT_ID=
# Use ungrouped to start, or replace with a groupId returned by the Brew API.
# For single-email-only mode, clear BREW_GROUP_ID and set BREW_EMAIL_ID.
BREW_GROUP_ID=ungrouped
BREW_EMAIL_ID=
# Optional: use a trusted Brew preview or local deployment origin.
BREW_EMBED_ORIGIN=https://brew.new
