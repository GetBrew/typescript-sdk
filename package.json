{
  "name": "@brew.new/sdk",
  "version": "12.2.0",
  "description": "Official TypeScript SDK for the Brew public API.",
  "license": "MIT",
  "author": "Brew",
  "homepage": "https://github.com/GetBrew/typescript-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetBrew/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/GetBrew/typescript-sdk/issues"
  },
  "keywords": [
    "brew",
    "brew.new",
    "sdk",
    "typescript",
    "api",
    "contacts",
    "marketing"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./embed": {
      "import": {
        "types": "./dist/embed.d.ts",
        "default": "./dist/embed.js"
      },
      "require": {
        "types": "./dist/embed.d.cts",
        "default": "./dist/embed.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "tsc": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "generate:types": "node scripts/generate-types.mjs",
    "prepublishOnly": "bun run clean && bun run generate:types && bun tsc && bun lint && bun run test && bun run build",
    "sync:embed": "node scripts/sync-embed-contracts.mjs",
    "sync:embed:check": "node scripts/sync-embed-contracts.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "msw": "^2.13.2",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
